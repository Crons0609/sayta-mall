# ============================================================
# SAYTA MALL — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# ── Firebase Client SDK (seguro de exponer al cliente) ──────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Firebase Admin SDK (SOLO server-side, NUNCA al cliente) ─
# Opción A: JSON completo del Service Account como string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Opción B: Campos individuales (alternativa a la opción A)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Roles y acceso ──────────────────────────────────────────
# Lista de correos del Programador (superadmin), separados por coma
PROGRAMMER_EMAILS=programador@ejemplo.com,otro@ejemplo.com

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sayta Mall

# ── Seguridad ────────────────────────────────────────────────
# Secret para firmar cookies de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=change_this_to_a_random_32char_string_minimum

# ── En producción (Render) ───────────────────────────────────
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://sayta-mall.onrender.com
